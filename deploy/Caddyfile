# Site block for MULE. Append to /etc/caddy/Caddyfile and replace the domain.
# Caddy obtains and renews the HTTPS certificate automatically.
mule.example.com {
	root * /var/www/mule/current
	encode zstd gzip
	file_server

	# Vite writes content-hashed bundles to /assets/, so they can be cached forever.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Everything else (index.html, maps, tilesets) is revalidated, so a deploy is visible immediately.
	@unhashed not path /assets/*
	header @unhashed Cache-Control "no-cache"
}
